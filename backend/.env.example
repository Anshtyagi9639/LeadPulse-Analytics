# LeadPulse backend (Express). Copy to backend/.env for local use. Never commit real keys.

PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:3000
# Set to 1 (number of proxy hops) when running behind a load balancer / reverse proxy, so rate limits see real client IPs.
TRUST_PROXY=false

# --- Temporary reporting sessions (no lead database) ---
# Sessions and their uploaded files are deleted after this many hours (max 72).
SESSION_TTL_HOURS=12
CLEANUP_INTERVAL_MINUTES=10
# Restricted temporary directory for uploads. Defaults to <OS temp>/leadpulse-sessions. Must not be web-served.
# TEMP_DIR=/var/tmp/leadpulse-sessions
# Non-sensitive data only: saved column-mapping templates and report history (aggregate KPIs). Never lead rows.
# CONFIG_DIR=./data
MAX_SESSIONS=200
# Report history (metadata + aggregate KPIs only, never lead rows) is kept this many days in CONFIG_DIR.
HISTORY_RETENTION_DAYS=30

# --- Upload limits & safety ---
MAX_FILE_SIZE_MB=15
MAX_FILES_PER_SESSION=20
MAX_ROWS_PER_SHEET=50000
MAX_ROWS_PER_SESSION=200000
MAX_COLUMNS=200
MAX_UNCOMPRESSED_MB=250
PARSE_TIMEOUT_MS=60000
PARSE_MEMORY_MB=768
PARSE_IN_WORKER=true

# Currency code used in reports and exports.
CURRENCY=INR

# --- Optional: AI insights via the official OpenAI SDK ---
# Leave empty to disable AI insights; dashboards and exports work without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=45000
AI_MAX_REQUESTS_PER_SESSION=30
AI_RATE_LIMIT_PER_MINUTE=6
# Counsellor names are replaced with "Counsellor 1, 2, …" before being sent to the AI unless this is true.
AI_INCLUDE_COUNSELLOR_NAMES=false
